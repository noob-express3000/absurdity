GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

EXA_API_KEY=
TAVILY_API_KEY=

# Production: PostgreSQL connection string (Supabase/Render/other Postgres).
# Local fallback: omit DATABASE_URL and Absurdity uses node:sqlite.
DATABASE_URL=
ABSURDITY_SQLITE_PATH=.data/absurdity.db

ABSURDITY_MODE=demo
RESEARCH_WINDOW_HOURS=30
RESEARCH_MAX_CANDIDATES=12
