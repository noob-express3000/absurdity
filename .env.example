GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

EXA_API_KEY=
TAVILY_API_KEY=

# Production: Turso Cloud.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Production/Render must set Turso. Local development may leave this false and use SQLite.
ABSURDITY_REQUIRE_TURSO=false

# Local development fallback: omit Turso credentials and use local SQLite.
ABSURDITY_SQLITE_PATH=.data/absurdity.db

ABSURDITY_MODE=demo
RESEARCH_WINDOW_HOURS=30
RESEARCH_MAX_CANDIDATES=12
EXA_DISCOVERY_RESULTS_PER_QUERY=6
